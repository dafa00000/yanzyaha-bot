# ═══════════════════════════════════════════════
# YANZYAHA-BOT ENVIRONMENT VARIABLES
# Copy → .env di /opt/data/bots/yanzyaha-bot/ lalu isi value
# ═══════════════════════════════════════════════

# === WA PAIRING (WAJIB) ===
# Nomor WA buat pairing code. Format 62xxx (tanpa + / spasi)
PHONE_NUMBER=628xxxxxxxxxx

# === LLM BACKEND (WAJIB buat fitur AI) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
HERMES_MODEL=anthropic/claude-sonnet-4

# Path data persistent (Railway/Hermes volume)
HERMES_HOME=/opt/data

# Optional Hermes CLI subprocess (kalau mau bridge ke hermes CLI)
# HERMES_BIN=/opt/hermes/bin/hermes
HERMES_TIMEOUT_MS=180000
# Max chat AI per user per hari. 0 = unlimited
WA_AI_DAILY_LIMIT=0

# === OPTIONAL: Whale tracker Solana ===
HELIUS_API_KEY=
WALLET_PUBLIC_KEY=
WALLET_PRIVATE_KEY=

# === OPTIONAL: Gemini / Groq ===
GEMINI_KEY=
GROQ_API_KEY=

# === OPTIONAL: Download helpers ===
# UPDATE_YT_DLP=1
# IG_SESSIONID=
# IG_CSRFTOKEN=
# IG_USER_ID=
# IG_COOKIES_FILE=
# FB_COOKIES_FILE=
# COBALT_URL=
# WEATHER_API_KEY=

# === OPTIONAL: Autoclip LLM ===
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# AUTOCLIP_LLM=
