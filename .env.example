# ═══════════════════════════════════════════════
# YANZYAHA-BOT ENVIRONMENT VARIABLES
# Copy file ini jadi .env, lalu isi value-nya
# ═══════════════════════════════════════════════

# === WA PAIRING (WAJIB) ===
# Nomor WA buat pairing code. Format 62xxx (drop leading 0)
PHONE_NUMBER=628xxxxxxxxxx

# === LLM BACKEND (WAJIB) ===
# API key dari provider lo (tokenrouter / openrouter / openai / dll)
OPENAI_API_KEY=sk-xxxxxxxxxxxx
# Base URL provider lo
OPENAI_BASE_URL=https://api.tokenrouter.com/v1
# Model yang mau dipake
HERMES_MODEL=anthropic/claude-sonnet-4

# Helius API key (for whale tracker — Solana)
HELIUS_API_KEY=

# Your Solana wallet (for auto-buy/sell)
WALLET_PUBLIC_KEY=
WALLET_PRIVATE_KEY=
HERMES_BIN=hermes
# Subprocess timeout (ms). Default: 180000 (3 menit)
HERMES_TIMEOUT_MS=180000
# Max chat AI per user per hari. 0 = unlimited
WA_AI_DAILY_LIMIT=0

# === OPTIONAL: Gemini (admin commands) ===
GEMINI_KEY=
# === OPTIONAL: Groq (image gen translate) ===
GROQ_API_KEY=
# === OPTIONAL: Auto-update yt-dlp tiap container start ===
UPDATE_YT_DLP=1
